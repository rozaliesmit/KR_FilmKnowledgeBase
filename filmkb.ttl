# Film Knowledge Base Data

@prefix : <default_namespace> .
@prefix owl: <owl_axiom_namespace> .
@prefix rdf: <list_base_namespace> .
@prefix rdfs: <rdfs_namespace> .
@prefix xsd: <datatype_namespace> .

# Classes 
## Main film and genre classes
:Film a owl:Class ; # a is short for rdf:type
    owl:hasKey ( :hasTitle :hasReleaseYear) ;
    rdfs:comment "A movie/motion picture"   .

:LiteraryWork a owl:Class;
    owl:disjointWith :Film ;
    rdfs:comment "Book, play or story a film can be based on".

:Genre a owl:Class ; 
    rdfs:comment "Category of film content" .

:Country a owl:Class ;
    rdfs:comment "Country of production" .

:Language a owl:Class ;
    rdfs:comment "Spoken language of a film or user" .

:Person a owl:Class .

:Franchise a owl:Class ;
    rdfs:comment "Series of related films"  .

:User a owl:Class ;
    rdfs:comment "Person with account on platform"  .

:Review a owl:Class ;
    rdfs:comment "Review of a film by a user"   .

:Group a owl:Class ;
    rdfs:comment "Group of users planning a movie night"    .

## SubGenres
:HorrorGenre a owl:Class ;
    rdfs:subClassOf :Genre ;
    rdfs:comment "Genre of films meant to frighten" .

:SlasherGenre a owl:Class ;
    rdfs:subClassOf :HorrorGenre ;
    rdfs:comment "Subgenre of horror centered on a killer stalking victims" .

:ComedyGenre a owl:Class ; 
    rdfs:subClassOf :Genre ;
    rdfs:comment "genre of films meant to amuse" .

:HorrorFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film 
            [ a owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:someValuesFrom :HorrorGenre
            ]
        )] ;
    rdfs:comment "Film that has at least one horror (sub)genre)" .

:ComedyFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film
            [ a owl:Restriction ;
                owl:onProperty :hasGenre ;
                owl:someValuesFrom :ComedyGenre
            ]
        )] ;
    rdfs:comment "Film with a comedy genre" .

:HorrorComedy a owl:Class ; 
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :HorrorFilm :ComedyFilm )] ;
        rdfs:comment "Film that combines horror and comedy" .

:Documentary a owl:Class ;
    rdfs:subClassOf :Film ;
    owl:disjointWith :FictionFilm ;
    rdfs:comment "Non-fiction film about real events or people" .

:FictionFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film 
            [ a owl:Class ;
                owl:complementOf :Documentary 
        ])] ;
    rdfs:comment "All films that are not documentaries" .

:ShortFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film
            [ a owl:Restriction ;
                owl:onProperty :hasRuntime ;
                owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:int ;
                    owl:withRestrictions ( [ xsd:maxExclusive "40"^^xsd:int ])
                ]])] ;

    rdfs:comment "Film shorter than 40 minutes" .

:EuropeanFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film
            [ a owl:Restriction ;
                owl:onProperty :producedIn ;
                owl:someValuesFrom [a owl:Class ;
                    owl:oneOf ( :France :Italy :Netherlands :Germany)]])];
    rdfs:comment "Film produced in a European country. More countries can be added".

## Related movie type classes
:Remake a owl:Class ; 
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film
            [ a owl:Restriction ; 
                owl:onProperty :isRemakeOf ;
                owl:someValuesFrom :Film])] ;
    rdfs:comment "New version of an earlier film"  .

:Sequel a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film
            [ a owl:Restriction ;
                owl:onProperty :isSequelOf ;
                owl:someValuesFrom :Film])];
    rdfs:comment "Film that continues the story of an earlier film".

:Adaptation a owl:Class ; 
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film
            [ a owl:Restriction ;
                owl:onProperty :basedOn ;
                owl:someValuesFrom :LiteraryWork])];
    rdfs:comment "Film based on a literary work".

## Age ratings and content warning classes
:AgeRating a owl:Class ; 
    owl:equivalentClass[ a owl:Class ;
        owl:oneOf (:Age_AL :Age_6 :Age_9 :Age_12 :Age_14 :Age_16 :Age_18)];
    rdfs:comment "Age classification for a movie".

:SuitableFor12 a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (:Film
            [ a owl:Restriction ;
                owl:onProperty :hasAgeRating ;
                owl:someValuesFrom [ a owl:Class ;
                    owl:oneOf ( :Age_AL :Age_6 :Age_9 :Age_12 )]])] ;
    rdfs:comment "Film suitable for viewers aged 12 and under".

:ContentWarning a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:unionOf ( :MildWarning :SevereWarning)];
    rdfs:comment "warning about potentially disturbing content".

:MildWarning a owl:Class ;
    rdfs:subClassOf :ContentWarning ;
    owl:disjointWith :SevereWarning ;
    rdfs:content "Content warning of low intensity".

:SevereWarning a owl:Class ; 
    rdfs:subClassOf :ContentWarning ;
    rdfs:comment "Content warning of high intensity".

:FamilyFriendlyFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (:Film
            [ a owl:Restriction ;
                owl:onProperty :hasContentWarning ;
                owl:allValuesFrom :MildWarning])];
    rdfs:comment "Film with only mild content warnings.".

:WarningFreeFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Film
            [ a owl:Restriction ;
                owl:onProperty :hasContentWarning ;
                owl:maxCardinality "0"^^xsd:nonNegativeInteger])];
    rdfs:comment "Film without any content warning". # use maxCardinality to indicate that the property has no values for this class and excludes subclasses that have non-zero values or no values

# People classes
:Director a owl:Class ; 
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Person
            [ a owl:Restriction ;
                owl:onProperty :directed ;
                owl:someValuesFrom :Film])] ;
    rdfs:comment "Person who directed at least one film".

:Actor a owl:Class ; 
    owl:equivalentClass [ a owl:Class;
        owl:intersectionOf (:person
        [ a owl:Restriction;
            owl:onProperty :actedIn;
            owl:someValuesFrom :Film])];
    rdfs:comment "Person who acted in at least one film".

:ActorDirector a owl:Class; 
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( :Actor :Director)];
    rdfs:comment "Person who both acted and directed".

:CastRole a owl:Class ;
    rdfs:comment "Role played by an actor in a film".

:LeadRole a owl:Class; 
    rdfs:subclassOf :CastRole ;
    rdfs:comment "Leading part in a film".

:EnsembleFilm a owl:Class ;
    owl:equivalentClass [ a owl:Class;
        owl:intersectionOf (:Film
            [ a owl:Restriction ; owl:onProperty :hasCastRole;
                owl:minQualifiedCardinality "5"^^xsd:nonNegativeInteger;
                owl:onClass :LeadRole])];
    rdfs:comment "Film with at least five lead roles".
 
:AuteurFilm a owl:Class ; 
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (:Film
            [ a owl:Restriction;
                owl:onProperty :directedAndWrittenBy;
                owl:someValuesFrom :Person])];
    rdfs:comment "Film written and directed by the same person".

## Franchise class 
:Trilogy a owl:Class ; 
    owl:equivalentClass [ a owl:Class;
        owl:intersectionOf ( :Franchise
            [ a owl:Restriction;
                owl:onProperty :hasPart;
                owl:qualifiedCardinality "3"^^xsd:nonNegativeInteger;
                owl:onClass :Film])];
    rdfs:comment "Franchise of three films".


# Properties

## Main movie properties
:hasReleaseYear a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain :Film ;
    rdfs:range xsd:int ;
    rdfs:comment "Year of first release".

:hasTitle a owl:DatatypeProperty ;
    rdfs:comment "Title of a film" ;
    rdfs:domain :Film ; 
    rdfs:range xsd:string .

:hasRuntime a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:comment "Runtime of a film in minutes" ;
    rdfs:domain :Film ; 
    rdfs:range xsd:int .

:isRemakeOf a owl:ObjectProperty , owl:IrreflexiveProperty ;
    owl:inverseOf :hasRemake ;
    rdfs:domain :Film ;
    rdfs:range :Film ;
    rdfs:comment "Links remake to its original film"    .

:hasRemake a owl:ObjectProperty ;
    rdfs:comment "inverse of isRemakeOf"   .

:isSequelOf a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:subPropertyOf :comesAfter ; 
    rdfs:comment "Sequel relation between two films"    .

:comesAfter a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:domain :Film ; 
    rdfs:range :Film ;
    rdfs:comment "Film comes after another one in a franchise / trilogy ".

:basedOn a owl:ObjectProperty ;
    rdfs:domain :Film ;
    rdfs:range :LiteraryWork ;
    rdfs:comment "Literary work a film is adapted from".

:producedIn a owl:ObjectProperty ;
    rdfs:domain :Film ;
    rdfs:range :Country ;
    rdfs:comment "country where the film was produced".

:hasAgeRating a owl:ObjectProperty ;
    rdfs:domain :Film ;
    rdfs:range :AgeRating ;
    rdfs:comment "Recommended age rating of a film".

:hasContentWarning a owl:ObjectProperty ;
    rdfs:domain :Film ;
    rdfs:range :ContentWarning ;
    rdfs:comment "Content warnings of a film".

:hasOriginalLanguage a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain :Film ;
    rdfs:range :Language ;
    rdfs:comment "Original spoken language of a film".

## People properties
:directed a owl:ObjectProperty ;
    rdfs:comment "Films a person directed (inverse of directedBy)".

:directedBy a owl:ObjectProperty ;
    owl:inverseOf :directed;
    rdfs:domain :Film ;
    rdfs:range :Person ;
    rdfs:comment "Director of a film".

:actedIn a owl:ObjectProperty ; 
    rdfs:domain :Person ;
    rdfs:range :Film ;
    owl:propertyChainAxiom ([owl:inverseOf :playedBy] [owl:inverseOf :hasCastRole]);
    rdfs:comment "Films a person acted in; derived from cast roles and playedBy".

:playedBy a owl:ObjectProperty , owl:FunctionalProperty;
    rdfs:domain :CastRole ;
    rdfs:range :Person ;
    rdfs:comment "Actor who plays a role in a film".

:hasCastRole a owl:ObjectProperty ;
    rdfs:domain :Film;
    rdfs:range :CastRole;
    rdfs:comment "Links a film to its cast roles".

:writtenBy a owl:ObjectProperty ;
    rdfs:domain :Film;
    rdfs:range :Person;
    rdfs:comment "Screenwriter of a film".

:directedAndWrittenBy a owl:ObjectProperty;
    rdfs:subPropertyOf :directedBy , :writtenBy;
    rdfs:comment "Film is both written and directed by the same person".

## Franchise properties
:partOfFranchise a owl:ObjectProperty;
    owl:inverseOf :hasPart;
    rdfs:domain :Film;
    rdfs:range :Franchise;
    rdfs:comment "Franchise a film belongs to".

:hasPart a owl:ObjectProperty;
    rdfs:comment "Films that make up a franchise (inverse of partOfFranchise)".

# Value restrictions
## Countries
:France a :Country.
:Italy a :Country.
:Netherlands a :Country.
:Germany a :Country.

## Age ratings
:Age_AL a :AgeRating.
:Age_6 a :AgeRating.
:Age_9 a :AgeRating.
:Age_12 a :AgeRating.
:Age_14 a :AgeRating.
:Age_16 a :AgeRating.
:Age_18 a :AgeRating.

## languages
:English a :Language.
:French a :Language.
:Dutch a :Language.
:German a :Language.